# ============================================================
# .env.example — 复制为 .env 并填入真实值
# 包含容器发布版本、密钥和凭证；业务配置仍统一放在 config/config.json
# ============================================================

# ── 容器发布版本 ──
# 个人试用可保留 latest；生产环境建议固定为 CI 发布的 sha-xxxxxxx 标签，便于审计和回滚。
APP_IMAGE_TAG=latest

# ── AI 翻译密钥（支持 Google Gemini 与 智谱清言，配置两者将开启双引擎智能轮番调度）──
GEMINI_API_KEY=your_gemini_key_here
ZHIPU_API_KEY=your_zhipu_key_here

# ── Telegram Bot（每个 Bot 独立凭证）──
# 变量名 = config.json 中 Bot 名称转为大写后 + _TOKEN
# 例如 tg_bot1 → TG_BOT1_TOKEN；请按实际 Bot 列表逐项填写
TG_BOT1_TOKEN=123456:ABC-DEF
# TG_BOT2_TOKEN=123456:XYZ-UVW
# 旧版全局 TG_BOT_TOKEN 已废弃，不会被使用

# ── 网页管理端（config.json 的 web_admin 控制开关）──
# 设置后所有 /api 请求须带 X-Auth-Token 头；只绑 127.0.0.1 时可留空
WEB_ADMIN_TOKEN=

# ── NapCat 入站群消息解析（可选，必须使用高强度随机 Token）──
# NapCat HTTP POST / 反向 WebSocket 事件上报时使用同一个 Token。
# 未设置时，即使 config.json 开启 napcat_inbound，监听端口也不会启动。
NAPCAT_EVENT_TOKEN=
# with-napcat Compose 的宿主机绑定地址；同 Compose 保持 127.0.0.1，
# Windows NapCat 跨主机时改成 NAS 局域网 IP（例如 192.168.1.10）。
NAPCAT_EVENT_BIND=127.0.0.1
# 多媒体动态合并转发（可选）：定时任务没有入站事件时填写 NapCat 登录 QQ 号。
# 入站反向 WebSocket 会自动使用事件里的 self_id，可留空。
NAPCAT_FORWARD_USER_ID=
NAPCAT_FORWARD_NICKNAME=坂道监控

# ── 账号凭证 ──
# 命名规则：config.json 中 accounts 的 key 大写 + _TOKEN / _COOKIE / _REFRESH_TOKEN
# web 账号（默认）需要 TOKEN + COOKIE
# mobile 账号（"auth": "mobile"）需要 REFRESH_TOKEN（必填）+ TOKEN（可选，留空自动获取）
NOGIZAKA_MAIN_REFRESH_TOKEN=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
NOGIZAKA_MAIN_TOKEN=
NOGIZAKA_SHARED_TOKEN=eyJ...
NOGIZAKA_SHARED_COOKIE=session=xxx
HINATA_SHARED_TOKEN=eyJ...
HINATA_SHARED_COOKIE=session=xxx
YODEL_GRAD_TOKEN=eyJ...
YODEL_GRAD_COOKIE=S5SI=xxx; 4FB852B4CF8A4CFF=yyy

# ── QQ 官方 Bot（可选，不启用则留空）──
# 推荐方式：在 config.json（或网页管理端）的 qq_official_bots 里声明 Bot
# （name / app_id / target_openid），这里只放密钥：Bot名称大写_CLIENT_SECRET
QQ_OFFICIAL_BOT1_CLIENT_SECRET=
# 旧方式兼容：config.json 未声明时自动扫描编号槽位 QQ_OFFICIAL_BOT{1..20}_*
QQ_OFFICIAL_BOT1_APP_ID=
QQ_OFFICIAL_BOT1_TARGET_OPENID=
QQ_OFFICIAL_BOT2_APP_ID=
QQ_OFFICIAL_BOT2_CLIENT_SECRET=
QQ_OFFICIAL_BOT2_TARGET_OPENID=

# ── NapCat QQ / OneBot 11 容器服务（可选，配合 docker-compose.with-napcat.yml）──
# NAPCAT_ACCOUNT: 登录的 QQ 号码（可留空使用扫码登录）
# NAPCAT_WEBUI_TOKEN: NapCat WebUI 后台安全 Token（默认建议修改为高强度密码）
NAPCAT_ACCOUNT=
NAPCAT_WEBUI_TOKEN=change_this_token
# NapCat OneBot 服务基地址与 API Token（可在 Web 管理端填写；这里填写会覆盖 config.json）
# 发送动作由主程序自动拼接，不要把 /send_group_msg 或 ?access_token=... 写进基地址。
# NAPCAT_API_BASE=http://napcat:36036
# NAPCAT_API_TOKEN=
# 远程 NapCat 媒体 URL 的签名与租约（建议固定密钥；租约默认 1800 秒）
# NAPCAT_MEDIA_SIGNING_SECRET=请填写高强度随机值
# NAPCAT_MEDIA_URL_TTL_SECONDS=1800
# 小图片可直接以内联 base64 发送，降低跨主机媒体请求；留空使用程序默认值
# NAPCAT_INLINE_IMAGE_MAX_BYTES=4194304
# NAPCAT_INLINE_IMAGE_BATCH_MAX_BYTES=16777216

# ── NapCat AI 拟人群聊（模拟乃木坂46 冨里奈央，基于 CPA 反代 Codex Luna）──
# ENABLE_NAPCAT_AI_CHAT=false
# CPA_BASE_URL=http://127.0.0.1:8317
# CPA_API_KEY=your_cpa_api_key_here
# CPA_MODEL=gpt-5.6-luna
# CPA_ENDPOINT=/v1/chat/completions
# CPA_ALLOWED_GROUPS=123456,789012
