# ============================================================
# .env.example — 把这个文件复制为 .env 并填入真实值
# 用法：
#   1. cp .env.example .env
#   2. 填写下方所有变量
#   3. pip install -r requirements.txt
#   4. python main.py
#
# .env 文件绝对不要提交到 Git（已在 .gitignore 中排除）
# ============================================================

# ── Gemini 翻译 API Key ─────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here

# ── QQ 推送通道开关 ─────────────────────────────────────────
# 可选组合：
#   只用 NapCat: ENABLE_NAPCAT_QQ=true, ENABLE_QQ_OFFICIAL_BOT=false
#   只用官方 Bot: ENABLE_NAPCAT_QQ=false, ENABLE_QQ_OFFICIAL_BOT=true
#   两者同时用: 两个都 true
#   完全不推送 QQ: 两个都 false
ENABLE_NAPCAT_QQ=true
ENABLE_QQ_OFFICIAL_BOT=false

# NapCat / OneBot HTTP 地址
# 注意：当前默认从 config/config.json 的 qq_bot_api 读取；此变量仅作记录，默认不会自动覆盖。
QQ_BOT_API=http://127.0.0.1:3000/send_group_msg

# ── QQ 开放平台官方 Bot（支持多个）──────────────────────────
# Bot 1（你的）
QQ_OFFICIAL_BOT1_APP_ID=your_bot_app_id
QQ_OFFICIAL_BOT1_CLIENT_SECRET=your_bot_client_secret
QQ_OFFICIAL_BOT1_TARGET_OPENID=your_user_openid

# Bot 2（朋友的）- 可选，留空则跳过
QQ_OFFICIAL_BOT2_APP_ID=
QQ_OFFICIAL_BOT2_CLIENT_SECRET=
QQ_OFFICIAL_BOT2_TARGET_OPENID=

# 向后兼容：如果使用旧版单 Bot 配置，可保留以下三行（优先级低于上方配置）
# QQ_OFFICIAL_APP_ID=your_bot_app_id
# QQ_OFFICIAL_CLIENT_SECRET=your_bot_client_secret
# QQ_OFFICIAL_TARGET_OPENID=your_user_openid

# ── B站全局默认 Cookie（冨里奈央用这个发帖）─────────────────
# 从浏览器开发者工具 → Application → Cookies 里复制
BILIBILI_FULL_COOKIE=SESSDATA=xxx; bili_jct=yyy
BILIBILI_BILI_JCT=yyy

# ── 移动端账号 refresh_token（auth_method: "mobile" 时使用）─────────
# 在 config.json 对应账号中设置 "auth_method": "mobile" 并填入
# "init_refresh_token": "$ENV:NOGIZAKA_REFRESH_TOKEN"
NOGIZAKA_REFRESH_TOKEN=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
HINATAZAKA_REFRESH_TOKEN=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# ── 账号凭证（首次运行用于初始化，之后从 web_credentials/ 读取）──
# nogizaka_main
ACCOUNT_NOGIZAKA_MAIN_TOKEN=eyJhbGciOiJIUzI1NiIs...
ACCOUNT_NOGIZAKA_MAIN_COOKIE=session=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# nogizaka_shared
ACCOUNT_NOGIZAKA_SHARED_TOKEN=eyJhbGciOiJIUzI1NiIs...
ACCOUNT_NOGIZAKA_SHARED_COOKIE=session=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# hinata_shared
ACCOUNT_HINATA_SHARED_TOKEN=eyJhbGciOiJIUzI1NiIs...
ACCOUNT_HINATA_SHARED_COOKIE=session=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# hinata_main（当前默认 config.json 未使用；如自行新增账号可参考）
ACCOUNT_HINATA_MAIN_TOKEN=eyJhbGciOiJIUzI1NiIs...
ACCOUNT_HINATA_MAIN_COOKIE=session=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# yodel_graduated（毕业生 member，如松田好花）
ACCOUNT_YODEL_TOKEN=eyJhbGciOiJIUzI1NiIs...
ACCOUNT_YODEL_COOKIE=S5SI=xxx; 4FB852B4CF8A4CFF=yyy

# ── 成员独立 B站 Cookie（留空则使用上方全局默认）────────────
# 仅当 config.json 中某成员配置 bilibili_cookie: "$ENV:MEMBER_85_BILIBILI_COOKIE" 时使用
MEMBER_85_BILIBILI_COOKIE=SESSDATA=xxx; bili_jct=yyy
