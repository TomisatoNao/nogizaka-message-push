{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "坂道联合监控系统配置（精简版）",
  "type": "object",
  "required": [
    "accounts",
    "monitor"
  ],
  "properties": {
    "channels": {
      "type": "object",
      "properties": {
        "napcat": {
          "type": "boolean",
          "default": true
        },
        "tg": {
          "type": "boolean",
          "default": false
        },
        "qq_official": {
          "type": "boolean",
          "default": false
        }
      }
    },
    "napcat_api": {
      "type": "string",
      "description": "旧版兼容字段；新配置请使用 napcat_api_base 与 napcat_api_token。"
    },
    "napcat_api_base": {
      "type": "string",
      "maxLength": 2048,
      "description": "NapCat/OneBot 服务基地址，不含动作路径、查询参数或 access_token。"
    },
    "napcat_api_token": {
      "type": "string",
      "maxLength": 512,
      "description": "NapCat/OneBot access_token；与基地址分开保存。"
    },
    "napcat_forward_user_id": {
      "type": ["string", "integer"],
      "description": "合并转发自定义节点使用的 NapCat 登录 QQ 号；入站事件可自动提供。"
    },
    "napcat_forward_nickname": {
      "type": "string",
      "default": "坂道监控"
    },
    "napcat_inbound": {
      "type": "object",
      "description": "NapCat/OneBot 11 入站群消息解析监听。必须同时配置 NAPCAT_EVENT_TOKEN。",
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": false
        },
        "transport": {
          "type": "string",
          "enum": ["http_post", "reverse_ws"],
          "default": "http_post"
        },
        "listen_host": {
          "type": "string",
          "minLength": 1
        },
        "listen_port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535,
          "default": 46047
        },
        "event_path": {
          "type": "string",
          "pattern": "^/[^\\s]{0,127}$",
          "default": "/api/napcat/events"
        },
        "translate": {
          "type": "boolean",
          "default": false
        },
        "archive": {
          "type": "boolean",
          "default": false
        },
        "max_links_per_message": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4,
          "default": 1
        },
        "queue_size": {
          "type": "integer",
          "minimum": 1,
          "maximum": 256,
          "default": 32
        },
        "workers": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8,
          "default": 2
        },
        "cooldown_seconds": {
          "type": "number",
          "minimum": 0,
          "maximum": 3600,
          "default": 10
        },
        "dedupe_ttl_seconds": {
          "type": "number",
          "minimum": 1,
          "maximum": 86400,
          "default": 900
        },
        "request_timeout_seconds": {
          "type": "number",
          "minimum": 5,
          "maximum": 900,
          "default": 180
        },
        "max_message_bytes": {
          "type": "integer",
          "minimum": 1024,
          "maximum": 1048576,
          "default": 65536
        }
      }
    },
    "napcat_media_base_url": {
      "type": "string",
      "format": "uri-reference"
    },
    "napcat_media_signing_secret": {
      "type": "string"
    },
    "qq_official_bots": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z0-9_]+$"
          },
          "remark": {
            "type": "string"
          },
          "app_id": {
            "type": "string"
          },
          "target_openid": {
            "type": "string"
          },
          "group_openid": {
            "type": "string"
          },
          "push_message": {
            "type": "boolean",
            "default": true
          },
          "push_blog": {
            "type": "boolean",
            "default": false
          },
          "push_x": {
            "type": "boolean",
            "default": true
          },
          "push_instagram": {
            "type": "boolean",
            "default": true
          },
          "push_tiktok": {
            "type": "boolean",
            "default": true
          },
          "push_live": {
            "type": "boolean",
            "default": true
          },
          "push_alert": {
            "type": "boolean",
            "default": false
          },
          "member_filter": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "default": []
          },
          "blog_filter": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "default": []
          },
          "social_filter": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "default": []
          },
          "blog_card_mode": {
            "type": "string",
            "enum": [
              "card_and_images",
              "card_only",
              "text_and_images"
            ],
            "default": "card_and_images"
          }
        }
      }
    },
    "napcat_routes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "group_id"
        ],
        "properties": {
          "group_id": {
            "type": "integer"
          },
          "remark": {
            "type": "string"
          },
          "forward_user_id": {
            "type": ["string", "integer"],
            "description": "该路由合并转发节点使用的 NapCat 登录 QQ 号（可选）。"
          },
          "forward_nickname": {
            "type": "string",
            "description": "该路由合并转发节点显示昵称（可选）。"
          },
          "push_message": {
            "type": "boolean",
            "default": true
          },
          "push_blog": {
            "type": "boolean",
            "default": false
          },
          "push_x": {
            "type": "boolean",
            "default": true
          },
          "push_instagram": {
            "type": "boolean",
            "default": true
          },
          "push_tiktok": {
            "type": "boolean",
            "default": true
          },
          "push_live": {
            "type": "boolean",
            "default": true
          },
          "push_alert": {
            "type": "boolean",
            "default": false
          },
          "member_filter": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "default": []
          },
          "blog_filter": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "default": []
          },
          "social_filter": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "default": []
          },
          "blog_card_mode": {
            "type": "string",
            "enum": [
              "card_and_images",
              "card_only",
              "text_and_images"
            ],
            "default": "card_and_images"
          }
        }
      }
    },
    "tg_bots": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "remark": {
            "type": "string"
          },
          "target_chat": {
            "type": "string"
          },
          "push_message": {
            "type": "boolean",
            "default": true
          },
          "push_blog": {
            "type": "boolean",
            "default": false
          },
          "push_x": {
            "type": "boolean",
            "default": true
          },
          "push_instagram": {
            "type": "boolean",
            "default": true
          },
          "push_tiktok": {
            "type": "boolean",
            "default": true
          },
          "push_live": {
            "type": "boolean",
            "default": true
          },
          "push_alert": {
            "type": "boolean",
            "default": false
          },
          "member_filter": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "default": []
          },
          "blog_filter": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "default": []
          },
          "social_filter": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "default": []
          },
          "blog_card_mode": {
            "type": "string",
            "enum": [
              "card_and_images",
              "card_only",
              "text_and_images"
            ],
            "default": "card_and_images"
          }
        }
      }
    },
    "web_admin": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": false
        },
        "host": {
          "type": "string"
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "origin": {
          "type": "string",
          "pattern": "^https?://[^/]+$"
        }
      }
    },
    "archive": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": false
        },
        "dir": {
          "type": "string"
        },
        "media": {
          "type": "boolean",
          "default": true
        }
      }
    },
    "daily_summary": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": false
        },
        "hour": {
          "type": "integer",
          "minimum": 0,
          "maximum": 23
        }
      }
    },
    "qq_commands": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": false
        },
        "mode": {
          "type": "string",
          "enum": ["configured", "whitelist", "all"],
          "default": "configured"
        },
        "allow_openids": {
          "type": "array",
          "items": {
            "oneOf": [
              { "type": "string" },
              {
                "type": "object",
                "properties": {
                  "openid": { "type": "string" },
                  "name": { "type": "string" },
                  "type": { "type": "string" }
                },
                "required": ["openid"]
              }
            ]
          }
        }
      }
    },
    "auth": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": false
        },
        "archive_public": {
          "type": "boolean",
          "default": false
        },
        "session_hours": {
          "type": "integer",
          "minimum": 1,
          "maximum": 720
        },
        "cookie_secure": {
          "type": "boolean",
          "default": false
        }
      }
    },
    "accounts": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "group"
        ],
        "properties": {
          "group": {
            "type": "string",
            "enum": [
              "nogizaka46",
              "hinatazaka46",
              "sakurazaka46",
              "yodel"
            ]
          },
          "auth": {
            "type": "string",
            "enum": [
              "web",
              "mobile"
            ],
            "default": "web"
          },
          "app_tag": {
            "type": "string"
          },
          "api_base": {
            "type": "string",
            "format": "uri"
          },
          "web_origin": {
            "type": "string",
            "format": "uri"
          }
        }
      }
    },
    "monitor": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "account": {
            "type": "string"
          },
          "groups": {
            "type": "array",
            "items": {
              "type": "integer"
            },
            "default": []
          },
          "tg": {
            "type": "string"
          },
          "social": {
            "type": "object"
          }
        }
      }
    },
    "day_interval": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "description": "Message 日间自动巡查每轮完成后的随机等待区间（秒）",
      "items": {
        "type": "integer",
        "minimum": 1
      }
    },
    "night_interval": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "description": "Message 深夜自动巡查每轮完成后的随机等待区间（秒）；休眠时段优先级更高",
      "items": {
        "type": "integer",
        "minimum": 1
      }
    },
    "sleep_hours": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "description": "Message 自动巡查的完全暂停时段（起止 JST 小时）",
      "items": {
        "type": "integer",
        "minimum": 0,
        "maximum": 23
      }
    },
    "alert_cooldown": {
      "type": "integer",
      "minimum": 0,
      "description": "相同告警重复通知的冷却时间（秒），不影响轮询"
    },
    "qq_send_interval": {
      "type": "number",
      "minimum": 0,
      "description": "官方 QQ Bot 和 NapCat 发送请求的节流间隔（秒），不影响抓取频率"
    },
    "napcat_send_timeout_seconds": {
      "type": "number",
      "minimum": 1,
      "description": "单个 NapCat 路由发送（含有限重试）的最大等待时间（秒）"
    },
    "member_fetch_timeout_seconds": {
      "type": "number",
      "minimum": 1,
      "description": "单个成员消息抓取的最大等待时间（秒）"
    },
    "token_refresh_timeout_seconds": {
      "type": "number",
      "minimum": 1,
      "description": "单个账号 Token 续期的最大等待时间（秒）"
    },
    "message_cycle_timeout_seconds": {
      "type": "number",
      "minimum": 1,
      "description": "完整消息/博客巡查轮次的最大等待时间（秒）"
    },
    "monitor_stale_seconds": {
      "type": "number",
      "minimum": 1,
      "description": "后台巡查心跳判定为过期的等待时间（秒）"
    },
    "monitor_startup_grace_seconds": {
      "type": "number",
      "minimum": 0,
      "description": "首次启动尚未完成首轮巡查时的健康宽限期（秒）"
    },
    "translate": {
      "type": "boolean"
    },
    "gemini_models": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "url"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "url": {
            "type": "string",
            "format": "uri"
          }
        }
      }
    },
    "gemini_min_interval": {
      "type": "number",
      "minimum": 0
    },
    "translate_timeout": {
      "type": "integer",
      "minimum": 1
    },
    "translate_total_timeout": {
      "type": "integer",
      "minimum": 1,
      "description": "单篇博客翻译允许的总耗时（秒），包含模型 failover 与补偿批次"
    },
    "image_tagging": {
      "type": "boolean"
    },
    "gemini_tag_models": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "url"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "url": {
            "type": "string",
            "format": "uri"
          }
        }
      }
    },
    "gemini_tag_min_interval": {
      "type": "number",
      "minimum": 0
    },
    "message_monitor": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        }
      }
    },
    "monitor_schedule": {
      "type": "object",
      "description": "所有内容监控共用的 JST 日间、深夜与全局休眠策略",
      "properties": {
        "timezone": {
          "type": "string",
          "enum": ["Asia/Tokyo", "JST"]
        },
        "day_start_hour": {
          "type": "integer",
          "minimum": 0,
          "maximum": 23
        },
        "night_start_hour": {
          "type": "integer",
          "minimum": 0,
          "maximum": 23
        },
        "sleep_hours": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "description": "所有内容监控暂停的起止 JST 小时",
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 23
          }
        },
        "pause_content_monitors": {
          "type": "boolean",
          "default": true
        }
      }
    },
    "blog_monitor": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "hinatazaka": {
          "type": "boolean"
        },
        "nogizaka": {
          "type": "boolean"
        },
        "sakurazaka": {
          "type": "boolean"
        },
        "day_interval": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "integer",
            "minimum": 1
          }
        },
        "night_interval": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "integer",
            "minimum": 1
          }
        },
        "error_backoff_seconds": {
          "type": "integer",
          "minimum": 1
        },
        "error_backoff_max_seconds": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "blog_records": {
      "type": "object",
      "properties": {
        "hinatazaka": {
          "type": "string"
        },
        "nogizaka": {
          "type": "string"
        },
        "sakurazaka": {
          "type": "string"
        }
      }
    },
    "platforms": {
      "type": "object",
      "properties": {
        "x": {
          "type": "object",
          "properties": {
            "interval_seconds": {"type": "integer", "minimum": 1},
            "night_interval_seconds": {"type": "integer", "minimum": 0}
          }
        },
        "instagram": {
          "type": "object",
          "properties": {
            "interval_seconds": {"type": "integer", "minimum": 1},
            "night_interval_seconds": {"type": "integer", "minimum": 0},
            "interval_range_seconds": {
              "type": "array", "minItems": 2, "maxItems": 2,
              "items": {"type": "integer", "minimum": 1}
            },
            "night_interval_range_seconds": {
              "type": "array", "minItems": 2, "maxItems": 2,
              "items": {"type": "integer", "minimum": 1}
            },
            "story_interval_range_seconds": {
              "type": "array", "minItems": 2, "maxItems": 2,
              "items": {"type": "integer", "minimum": 1}
            }
          }
        },
        "tiktok": {
          "type": "object",
          "properties": {
            "interval_seconds": {"type": "integer", "minimum": 1},
            "night_interval_seconds": {"type": "integer", "minimum": 0}
          }
        },
        "tiktok_live": {
          "type": "object",
          "properties": {
            "interval_seconds": {"type": "integer", "minimum": 1},
            "night_interval_seconds": {"type": "integer", "minimum": 0}
          }
        }
      }
    },
    "social": {
      "type": "object"
    },
    "media": {
      "type": "object"
    },
    "proxy": {
      "type": "string",
      "default": "",
      "description": "全局 HTTP / SOCKS5 代理地址（如 http://127.0.0.1:7890 或 socks5://127.0.0.1:1080）"
    }
  }
}
