{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "坂道联合监控系统配置（精简版）",
  "type": "object",
  "required": [
    "accounts",
    "monitor"
  ],
  "properties": {
    "channels": {
      "type": "object",
      "properties": {
        "napcat": {
          "type": "boolean",
          "default": true
        },
        "tg": {
          "type": "boolean",
          "default": false
        },
        "qq_official": {
          "type": "boolean",
          "default": false
        }
      }
    },
    "napcat_api": {
      "type": "string"
    },
    "qq_official_bots": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z0-9_]+$"
          },
          "app_id": {
            "type": "string"
          },
          "target_openid": {
            "type": "string"
          },
          "group_openid": {
            "type": "string"
          },
          "push_message": {
            "type": "boolean",
            "default": true
          },
          "push_blog": {
            "type": "boolean",
            "default": false
          },
          "push_x": {
            "type": "boolean",
            "default": true
          },
          "push_instagram": {
            "type": "boolean",
            "default": true
          },
          "push_tiktok": {
            "type": "boolean",
            "default": true
          },
          "push_live": {
            "type": "boolean",
            "default": true
          },
          "push_alert": {
            "type": "boolean",
            "default": false
          },
          "member_filter": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "default": []
          },
          "blog_filter": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "default": []
          },
          "social_filter": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "default": []
          },
          "blog_card_mode": {
            "type": "string",
            "enum": [
              "card_and_images",
              "card_only",
              "text_and_images"
            ],
            "default": "card_and_images"
          }
        }
      }
    },
    "napcat_routes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "group_id"
        ],
        "properties": {
          "group_id": {
            "type": "integer"
          },
          "push_message": {
            "type": "boolean",
            "default": true
          },
          "push_blog": {
            "type": "boolean",
            "default": false
          },
          "push_x": {
            "type": "boolean",
            "default": true
          },
          "push_instagram": {
            "type": "boolean",
            "default": true
          },
          "push_tiktok": {
            "type": "boolean",
            "default": true
          },
          "push_live": {
            "type": "boolean",
            "default": true
          },
          "push_alert": {
            "type": "boolean",
            "default": false
          },
          "member_filter": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "default": []
          },
          "blog_filter": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "default": []
          },
          "social_filter": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "default": []
          },
          "blog_card_mode": {
            "type": "string",
            "enum": [
              "card_and_images",
              "card_only",
              "text_and_images"
            ],
            "default": "card_and_images"
          }
        }
      }
    },
    "tg_bots": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "target_chat": {
            "type": "string"
          },
          "push_message": {
            "type": "boolean",
            "default": true
          },
          "push_blog": {
            "type": "boolean",
            "default": false
          },
          "push_x": {
            "type": "boolean",
            "default": true
          },
          "push_instagram": {
            "type": "boolean",
            "default": true
          },
          "push_tiktok": {
            "type": "boolean",
            "default": true
          },
          "push_live": {
            "type": "boolean",
            "default": true
          },
          "push_alert": {
            "type": "boolean",
            "default": false
          },
          "member_filter": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "default": []
          },
          "blog_filter": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "default": []
          },
          "social_filter": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "default": []
          },
          "blog_card_mode": {
            "type": "string",
            "enum": [
              "card_and_images",
              "card_only",
              "text_and_images"
            ],
            "default": "card_and_images"
          }
        }
      }
    },
    "web_admin": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": false
        },
        "host": {
          "type": "string"
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        }
      }
    },
    "archive": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": false
        },
        "dir": {
          "type": "string"
        },
        "media": {
          "type": "boolean",
          "default": true
        }
      }
    },
    "daily_summary": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": false
        },
        "hour": {
          "type": "integer",
          "minimum": 0,
          "maximum": 23
        }
      }
    },
    "qq_commands": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": false
        },
        "allow_openids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "auth": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": false
        },
        "archive_public": {
          "type": "boolean",
          "default": false
        },
        "session_hours": {
          "type": "integer",
          "minimum": 1,
          "maximum": 720
        }
      }
    },
    "accounts": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "group"
        ],
        "properties": {
          "group": {
            "type": "string",
            "enum": [
              "nogizaka46",
              "hinatazaka46",
              "sakurazaka46",
              "yodel"
            ]
          },
          "auth": {
            "type": "string",
            "enum": [
              "web",
              "mobile"
            ],
            "default": "web"
          },
          "app_tag": {
            "type": "string"
          },
          "api_base": {
            "type": "string",
            "format": "uri"
          },
          "web_origin": {
            "type": "string",
            "format": "uri"
          }
        }
      }
    },
    "monitor": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "account": {
            "type": "string"
          },
          "groups": {
            "type": "array",
            "items": {
              "type": "integer"
            },
            "default": []
          },
          "tg": {
            "type": "string"
          },
          "social": {
            "type": "object"
          }
        }
      }
    },
    "day_interval": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "integer",
        "minimum": 1
      }
    },
    "night_interval": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "integer",
        "minimum": 1
      }
    },
    "sleep_hours": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "integer",
        "minimum": 0,
        "maximum": 23
      }
    },
    "alert_cooldown": {
      "type": "integer",
      "minimum": 0
    },
    "qq_send_interval": {
      "type": "number",
      "minimum": 0
    },
    "translate": {
      "type": "boolean"
    },
    "gemini_models": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "url"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "url": {
            "type": "string",
            "format": "uri"
          }
        }
      }
    },
    "gemini_min_interval": {
      "type": "number",
      "minimum": 0
    },
    "translate_timeout": {
      "type": "integer",
      "minimum": 1
    },
    "image_tagging": {
      "type": "boolean"
    },
    "gemini_tag_models": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "url"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "url": {
            "type": "string",
            "format": "uri"
          }
        }
      }
    },
    "gemini_tag_min_interval": {
      "type": "number",
      "minimum": 0
    },
    "message_monitor": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        }
      }
    },
    "blog_monitor": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "hinatazaka": {
          "type": "boolean"
        },
        "nogizaka": {
          "type": "boolean"
        },
        "sakurazaka": {
          "type": "boolean"
        },
        "day_interval": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "integer",
            "minimum": 1
          }
        },
        "night_interval": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    },
    "blog_records": {
      "type": "object",
      "properties": {
        "hinatazaka": {
          "type": "string"
        },
        "nogizaka": {
          "type": "string"
        },
        "sakurazaka": {
          "type": "string"
        }
      }
    },
    "platforms": {
      "type": "object",
      "properties": {
        "x": {
          "type": "object"
        },
        "instagram": {
          "type": "object"
        },
        "tiktok": {
          "type": "object"
        },
        "tiktok_live": {
          "type": "object"
        }
      }
    },
    "social": {
      "type": "object"
    },
    "media": {
      "type": "object"
    },
    "proxy": {
      "type": "string",
      "default": "",
      "description": "全局 HTTP / SOCKS5 代理地址（如 http://127.0.0.1:7890 或 socks5://127.0.0.1:1080）"
    }
  }
}