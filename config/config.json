  "accounts": {
    "nogizaka_main": {"group": "nogizaka46"}
  },

  // ── 监控成员 ──
  "monitor": [
    {"id": "55", "name": "冨里奈央", "account": "nogizaka_main", "groups": [533072575], "tg": "-1004219007326"}
  ],

  // ── 推送节奏 ──
