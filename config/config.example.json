{
  // ── 推送通道总开关（默认全关，按需在网页后台开启）──
  "channels": {
    "napcat": false,
    "tg": false,
    "qq_official": false
  },
  // NapCat 只填写服务基地址；发送动作（/send_group_msg、
  // /send_group_forward_msg、/get_status）由程序自动拼接。
  "napcat_api_base": "http://127.0.0.1:3000",
  "napcat_api_token": "",
  // 合并转发节点身份（可选）。入站反向 WebSocket 会自动使用事件里的 self_id；
  // 定时任务若也要将多媒体折叠发送，可填写 NapCat 登录 QQ 号和显示昵称。
  "napcat_forward_user_id": "",
  "napcat_forward_nickname": "坂道监控",
  // NapCat 位于其他主机时填写群晖可被其访问的地址；留空表示同机 file:// 模式
  "napcat_media_base_url": "",
  // 可选：固定媒体签名密钥；留空时使用 WEB_ADMIN_TOKEN 或进程随机密钥
  "napcat_media_signing_secret": "",

  // ── QQ 官方机器人列表（初始为空，在网页端添加）──
  "qq_official_bots": [],

  // ── NapCat (OneBot 11) 路由配置 ──
  "napcat_routes": [],

  // ── NapCat 入站群消息解析（默认关闭；Token 放在 .env）──
  // 只有 napcat_routes 中列出的群号会触发解析和回帖。
  "napcat_inbound": {
    "enabled": false,
    "transport": "http_post",
    "listen_host": "0.0.0.0",
    "listen_port": 46047,
    "event_path": "/api/napcat/events",
    "translate": false,
    "archive": false,
    "max_links_per_message": 1,
    "queue_size": 32,
    "workers": 2,
    "cooldown_seconds": 10,
    "dedupe_ttl_seconds": 900,
    "request_timeout_seconds": 180,
    "max_message_bytes": 65536
  },

  // ── Telegram Bot 路由配置 ──
  // 每个 Bot 的凭证放在 .env：名称 tg_bot1 对应 TG_BOT1_TOKEN
  "tg_bots": [],

  // ── 网页管理端（Docker 默认仅发布到宿主机 localhost）──
  "web_admin": {
    "enabled": true,
    "host": "0.0.0.0",
    "port": 46046,
    // 可选：固定唯一公开 Origin。留空时会自动适配同域 HTTPS 反向代理。
    // 仅在要限制为唯一访问域名、或代理未保留 Host 时填写。
    // "origin": "https://push.example.com"
  },

  // ── 消息归档 ──
  "archive": {
    "enabled": true,
    "dir": "data/archive",
    "media": true
  },

  // ── 每日摘要 ──
  "daily_summary": {
    "enabled": false,
    "hour": 23
  },

  // ── 官方 Bot 指令（/status, /search 等）──
  "qq_commands": {
    "enabled": false,
    "allow_openids": []
  },

  // ── 账号系统（登录鉴权）──
  "auth": {
    "enabled": true,
    "archive_public": false,
    "session_hours": 12,
    // HTTPS 反向代理部署时设为 true；localhost 直连 HTTP 请保持 false
    // "cookie_secure": true
  },

  // ── 账号池预设 ──
  "accounts": {
    "nogizaka_main": {"group": "nogizaka46"},
    "sakurazaka_main": {"group": "sakurazaka46"},
    "hinatazaka_main": {"group": "hinatazaka46"}
  },

  // ── Message 监控成员列表（初始为空，由用户在管理端添加）──
  "monitor": [],

  // ── Message 轮询开关（默认关闭）──
  "message_monitor": {
    "enabled": false
  },

  // ── Message 轮询节奏（秒）──
  // 日间/深夜是每轮 Message 巡查完成后的随机等待区间。
  "day_interval": [120, 180],
  "night_interval": [1500, 1800],
  // ── 全局内容监控时段（JST / UTC+9）──
  // 示例：日间 07:00-23:00，深夜 23:00-02:00，休眠 02:00-07:00。
  // 休眠暂停 Message、博客、X、Instagram、TikTok 的新一轮轮询，
  // 不停止健康检查、告警发送或已经开始的直播录制。
  "monitor_schedule": {
    "timezone": "Asia/Tokyo",
    "day_start_hour": 7,
    "night_start_hour": 23,
    "sleep_hours": [2, 7],
    "pause_content_monitors": true
  },
  // 以下不是 Message 抓取频率：告警通知冷却，以及 QQ/NapCat 发送层节流。
  "alert_cooldown": 3600,
  // Token 续期保护：每次最多并发 2 个，网络失败后指数退避（秒）
  "token_refresh_concurrency": 2,
  "token_refresh_network_cooldown_seconds": 90,
  "token_refresh_max_cooldown_seconds": 600,

  // ── 巡查超时与存活探针（秒）──
  // 成员抓取和 Token 续期独立计时；整轮预算覆盖 Message 处理，博客有独立预算。
  "member_fetch_timeout_seconds": 60,
  "token_refresh_timeout_seconds": 30,
  "message_cycle_timeout_seconds": 900,
  "monitor_stale_seconds": 1800,
  "monitor_startup_grace_seconds": 300,

  // ── 官方博客监控（默认关闭，按需开启指定团）──
  "blog_monitor": {
    "enabled": false,
    "hinatazaka": false,
    "nogizaka": false,
    "sakurazaka": false,
    "day_interval": [60, 120],
    "night_interval": [1650, 1950],
    // 博客抓取异常时指数退避，避免站点故障期间紧密重试。
    "error_backoff_seconds": 60,
    "error_backoff_max_seconds": 900
  },
  "blog_records": {
    "hinatazaka": "",
    "nogizaka": "",
    "sakurazaka": ""
  },

  // ── 社交媒体监控（X / Instagram / TikTok，默认全关）──
  "platforms": {
    "x": {
      "enabled": false,
      "interval_seconds": 60,
      "night_interval_seconds": 300,
      "accounts": [],
      "display_names": {}
    },
    "instagram": {
      "enabled": false,
      "include_feed": true,
      "include_stories": true,
      "interval_seconds": 1800,
      "night_interval_seconds": 5400,
      "interval_range_seconds": [1800, 3600],
      "night_interval_range_seconds": [5400, 10800],
      "accounts": [],
      "display_names": {},
      "cookies_file": "",
      "cookies_from_browser": "",
      "public_embed_enabled": true,
      "public_embed_timeout_seconds": 25,
      "public_embed_max_media": 20
    },
    "tiktok": {
      "enabled": false,
      "interval_seconds": 120,
      "accounts": [],
      "display_names": {}
    },
    "tiktok_live": {
      "enabled": false,
      "interval_seconds": 8,
      "accounts": [],
      "display_names": {}
    }
  },

  // ── AI 翻译配置（默认关闭，需在 .env 配置 GEMINI_API_KEY）──
  "translate": false,
  "gemini_models": [
    {"name": "gemini-3.7-flash", "url": "https://generativelanguage.googleapis.com/v1beta/models/gemini-3.7-flash:generateContent"},
    {"name": "glm-4-flash", "url": "https://open.bigmodel.cn/api/paas/v4/chat/completions"},
    {"name": "gemini-3.6-flash", "url": "https://generativelanguage.googleapis.com/v1beta/models/gemini-3.6-flash:generateContent"},
    {"name": "gemini-3.5-flash", "url": "https://generativelanguage.googleapis.com/v1beta/models/gemini-3.5-flash:generateContent"},
    {"name": "gemini-3.5-flash-lite", "url": "https://generativelanguage.googleapis.com/v1beta/models/gemini-3.5-flash-lite:generateContent"},
    {"name": "gemini-3.1-flash-lite", "url": "https://generativelanguage.googleapis.com/v1beta/models/gemini-3.1-flash-lite:generateContent"},
    {"name": "gemini-2.5-flash", "url": "https://generativelanguage.googleapis.com/v1beta/models/gemini-2.5-flash:generateContent"},
    {"name": "gemini-2.5-flash-lite", "url": "https://generativelanguage.googleapis.com/v1beta/models/gemini-2.5-flash-lite:generateContent"}
  ],
  "gemini_min_interval": 7,
  "translate_timeout": 90,
  "translate_total_timeout": 180,

  // ── AI 图片打标签（默认关闭）──
  "image_tagging": false,
  "qq_send_interval": 1.5,
  // 单个 NapCat 路由的发送总预算（秒）；不改变账号级发送间隔
  "napcat_send_timeout_seconds": 45
}
