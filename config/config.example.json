{
  // ── 推送通道总开关（默认全关，按需在网页后台开启）──
  "channels": {
    "napcat": false,
    "tg": false,
    "qq_official": false
  },
  "napcat_api": "http://127.0.0.1:3000/send_group_msg",

  // ── QQ 官方机器人列表（初始为空，在网页端添加）──
  "qq_official_bots": [],

  // ── NapCat (OneBot 11) 路由配置 ──
  "napcat_routes": [],

  // ── Telegram Bot 路由配置 ──
  // 每个 Bot 的凭证放在 .env：名称 tg_bot1 对应 TG_BOT1_TOKEN
  "tg_bots": [],

  // ── 网页管理端（Docker 默认仅发布到宿主机 localhost）──
  "web_admin": {
    "enabled": true,
    "host": "0.0.0.0",
    "port": 46046,
    // 可选：固定唯一公开 Origin。留空时会自动适配同域 HTTPS 反向代理。
    // 仅在要限制为唯一访问域名、或代理未保留 Host 时填写。
    // "origin": "https://push.example.com"
  },

  // ── 消息归档 ──
  "archive": {
    "enabled": true,
    "dir": "data/archive",
    "media": true
  },

  // ── 每日摘要 ──
  "daily_summary": {
    "enabled": false,
    "hour": 23
  },

  // ── 官方 Bot 指令（/status, /search 等）──
  "qq_commands": {
    "enabled": false,
    "allow_openids": []
  },

  // ── 账号系统（登录鉴权）──
  "auth": {
    "enabled": true,
    "archive_public": false,
    "session_hours": 12,
    // HTTPS 反向代理部署时设为 true；localhost 直连 HTTP 请保持 false
    // "cookie_secure": true
  },

  // ── 账号池预设 ──
  "accounts": {
    "nogizaka_main": {"group": "nogizaka46"},
    "sakurazaka_main": {"group": "sakurazaka46"},
    "hinatazaka_main": {"group": "hinatazaka46"}
  },

  // ── Message 监控成员列表（初始为空，由用户在管理端添加）──
  "monitor": [],

  // ── Message 轮询开关（默认关闭）──
  "message_monitor": {
    "enabled": false
  },

  // ── 推送节奏（秒）──
  "day_interval": [120, 180],
  "night_interval": [1500, 1800],
  "sleep_hours": [2, 7],
  "alert_cooldown": 3600,
  // Token 续期保护：每次最多并发 2 个，网络失败后指数退避（秒）
  "token_refresh_concurrency": 2,
  "token_refresh_network_cooldown_seconds": 90,
  "token_refresh_max_cooldown_seconds": 600,

  // ── 官方博客监控（默认关闭，按需开启指定团）──
  "blog_monitor": {
    "enabled": false,
    "hinatazaka": false,
    "nogizaka": false,
    "sakurazaka": false,
    "day_interval": [60, 120],
    "night_interval": [1650, 1950]
  },
  "blog_records": {
    "hinatazaka": "",
    "nogizaka": "",
    "sakurazaka": ""
  },

  // ── 社交媒体监控（X / Instagram / TikTok，默认全关）──
  "platforms": {
    "x": {
      "enabled": false,
      "interval_seconds": 60,
      "night_interval_seconds": 300,
      "accounts": [],
      "display_names": {}
    },
    "instagram": {
      "enabled": false,
      "include_feed": true,
      "include_stories": true,
      "interval_seconds": 1800,
      "night_interval_seconds": 5400,
      "accounts": [],
      "display_names": {},
      "cookies_file": "",
      "cookies_from_browser": "",
      "public_embed_enabled": true,
      "public_embed_timeout_seconds": 25,
      "public_embed_max_media": 20
    },
    "tiktok": {
      "enabled": false,
      "interval_seconds": 120,
      "accounts": [],
      "display_names": {}
    },
    "tiktok_live": {
      "enabled": false,
      "interval_seconds": 8,
      "accounts": [],
      "display_names": {}
    }
  },

  // ── AI 翻译配置（默认关闭，需在 .env 配置 GEMINI_API_KEY）──
  "translate": false,
  "gemini_models": [
    {"name": "gemini-3.7-flash", "url": "https://generativelanguage.googleapis.com/v1beta/models/gemini-3.7-flash:generateContent"},
    {"name": "glm-4-flash", "url": "https://open.bigmodel.cn/api/paas/v4/chat/completions"},
    {"name": "gemini-3.6-flash", "url": "https://generativelanguage.googleapis.com/v1beta/models/gemini-3.6-flash:generateContent"},
    {"name": "gemini-3.5-flash", "url": "https://generativelanguage.googleapis.com/v1beta/models/gemini-3.5-flash:generateContent"},
    {"name": "gemini-3.5-flash-lite", "url": "https://generativelanguage.googleapis.com/v1beta/models/gemini-3.5-flash-lite:generateContent"},
    {"name": "gemini-3.1-flash-lite", "url": "https://generativelanguage.googleapis.com/v1beta/models/gemini-3.1-flash-lite:generateContent"},
    {"name": "gemini-2.5-flash", "url": "https://generativelanguage.googleapis.com/v1beta/models/gemini-2.5-flash:generateContent"},
    {"name": "gemini-2.5-flash-lite", "url": "https://generativelanguage.googleapis.com/v1beta/models/gemini-2.5-flash-lite:generateContent"}
  ],
  "gemini_min_interval": 7,
  "translate_timeout": 90,
  "translate_total_timeout": 180,

  // ── AI 图片打标签（默认关闭）──
  "image_tagging": false,
  "qq_send_interval": 1.5
}
