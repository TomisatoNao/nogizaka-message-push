# 凭证和敏感数据 / 本地私有配置
.env
.env.*
!.env.example
.deploy-state
.deploy-state.*
data/web_credentials/
config/config.json

# 运行时产生的数据目录
data/
state/
messages/
config/history/

# 日志
logs/
*.log

# Python 缓存
__pycache__/
*.pyc
*.pyo

# AI 本地配置与规则文件
.claude/
CLAUDE.md
GEMINI.md

# Docker 镜像导出临时文件
*.tar

# 本地备份归档（通常含配置与凭据数据库）
backups/

# Git worktrees
.worktrees/

# 设计、审计与过程文档（仅保留在本地，不推送到版本库）
docs/
scratch/
# 长期有效的前端设计规范例外纳入版本库，供后续 agent 读取
!docs/
docs/*
!docs/frontend-design-guidelines.md
!docs/frontend-design-optimization-plan.md

# 测试与覆盖率
.coverage
.pytest_cache/
htmlcov/
# 本地私有部署脚本
tools/deploy_*.py
tools/deploy_to_nas.py
# 通用的无密码、固定镜像版本部署器需要随仓库维护。
!tools/deploy_release.py
